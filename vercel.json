  "outputDirectory": "frontend/web",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/upload", "destination": "/upload.html" },
    { "source": "/dashboard", "destination": "/dashboard.html" },
    { "source": "/analytics", "destination": "/analytics.html" }
  ]
}
