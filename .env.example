# Prescription Extractor SaaS Environment Configuration

ENV=development
DEBUG=True

# Neon Cloud PostgreSQL or Local Database Connection String
DATABASE_URL=postgresql://neondb_owner:npg_password@ep-sample-host.us-east-2.aws.neon.tech/neondb?sslmode=require

# OCR Configuration
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# File Upload Limits
MAX_UPLOAD_SIZE_MB=10
